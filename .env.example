# === Telegram Quiz Manager — example environment file ===
# Copy to ".env" and fill in real values. Never commit the real ".env".

# --- Application ---
APP_NAME="Telegram Quiz Manager"
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
# Where data/, logs/ and backups/ live (defaults to the project root).
APP_BASE_DIR=

# --- Secrets (REQUIRED) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Initial admin account, used only the first time the app starts.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# --- Telegram ---
# Bot token from @BotFather. Can also be set from the dashboard (Settings page);
# a token stored there wins over this value. Leave both empty to run in dry-run.
TELEGRAM_BOT_TOKEN=
# "polling" (default) or "webhook".
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Per-request Bot API timeout in seconds. Raise it on slow links: a quiz can be
# delivered while the reply read times out, which looks like a failure.
TELEGRAM_TIMEOUT=30

# --- Student Mini App (exam platform) ---
# Public HTTPS URL of this deployment. Used to build the bot's Mini App button
# (https://<url>/app) and the "open exams" inline button in /start.
# Leave empty to derive it: the webhook origin, or the bot's existing menu
# button URL. The Mini App is simply skipped when none can be resolved.
MINI_APP_URL=
# Reject Mini App initData older than this many seconds (0 disables the check).
TELEGRAM_AUTH_MAX_AGE=86400

# --- Database ---
# Storage backend. Empty => a local SQLite file at data/tqm.db (single process).
# Set to a PostgreSQL URL to use the pooled backend instead; this is what a
# multi-worker or multi-replica deployment needs. On Railway this is provided
# automatically by the Postgres service (e.g. ${{Postgres.DATABASE_URL}}).
DATABASE_URL=
# Upper bound on pooled PostgreSQL connections per process.
DB_POOL_MAX=10

# --- Scheduling ---
DEFAULT_TIMEZONE=Asia/Riyadh

# --- Session ---
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE=43200

# --- Userbot (optional MTProto transport) ---
# A userbot logs in as a real Telegram user account (api_id + api_hash) instead
# of a bot, for channels where a bot cannot post quizzes. Accounts are added and
# logged in from the dashboard (Settings -> userbot accounts); credentials are
# stored encrypted in the database (data/tqm.db), so nothing needs to be set here.
# The MTProto library is installed from requirements.txt (kurigram).
